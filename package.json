{
  "name": "console-stamp",
  "version": "4.0.0-rc.1",
  "type": "module",
  "description": "Patch NodeJS console methods in order to add timestamp information by pattern",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "examples": "node examples/index || true"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Ståle Raknes",
    "email": "stale@raknes.net",
    "url": "https://github.com/starak"
  },
  "contributors": [
    {
      "name": "Ståle Raknes",
      "url": "https://github.com/starak"
    },
    {
      "name": "Jotham Read",
      "url": "https://github.com/jotham"
    },
    {
      "name": "Christiaan Westerbeek",
      "url": "https://github.com/devotis"
    },
    {
      "name": "Leon Lucardie",
      "url": "https://github.com/Gameleon12"
    },
    {
      "name": "Steffan Donal",
      "url": "https://github.com/SteffanDonal"
    },
    {
      "name": "Sören Schwert",
      "url": "https://github.com/sisou"
    },
    {
      "name": "Fkscorpion",
      "url": "https://github.com/Fkscorpion"
    },
    {
      "name": "Alexis Tyler",
      "url": "https://github.com/OmgImAlexis"
    },
    {
      "name": "Jan Åge Lavik",
      "url": "https://github.com/jalavik"
    },
    {
      "name": "Alexey Zakhlestin",
      "url": "https://github.com/indeyets"
    }
  ],
  "keywords": [
    "console",
    "timestamp",
    "log",
    "jslog",
    "debug"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/starak/node-console-stamp.git"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "chalk-template": "^1.1.0",
    "dateformat": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  }
}
